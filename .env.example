APP_NAME="Polinema Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Notifikasi email (pengingat jatuh tempo) memakai queue. "sync" = dikirim langsung tanpa worker.
# Produksi: ganti ke database lalu jalankan `php artisan queue:work` (tabel jobs sudah ada di migrasi).
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Development: email verifikasi ditulis ke storage/logs/laravel.log.
# Untuk mengirim email sungguhan ganti ke smtp dan isi kredensial (lihat README).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@polinemalibrary.test"
MAIL_FROM_NAME="${APP_NAME}"

# Aturan peminjaman (lihat config/perpustakaan.php); kosongkan untuk memakai nilai default
# PERPUS_MASA_PINJAM=7
# PERPUS_MASA_PERPANJANG=14
# PERPUS_MAKS_PERPANJANG=1
# PERPUS_DENDA_PER_HARI=2000
# PERPUS_PENGINGAT_HARI_SEBELUM=1
# PERPUS_MASA_AMBIL_PENGAJUAN=3
